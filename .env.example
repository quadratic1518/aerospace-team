# Any OpenAI-compatible chat-completions server can be used.
# For a hosted OpenAI-compatible service, set its base URL, API key and model here.
# For Ollama: LLM_BASE_URL=http://localhost:11434/v1, LLM_API_KEY=ollama,
# and set LLM_MODEL to a model you have pulled.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model
